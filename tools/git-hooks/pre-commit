#!/bin/sh
# pre-commit (git config core.hooksPath tools/git-hooks): the .tyaml type check on the commit's .tyaml files. Only
# exit code 3 stops a commit; a crash, a missing python3 or anything else lets the commit through.
# What it does: tools/tyaml.py
set -f  # file names as written: no globbing, split on newlines only
IFS='
'
set -- $(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- '*.tyaml')
[ $# -eq 0 ] && exit 0
python3 "$(dirname "$0")/../tyaml.py" "$@"
[ $? -eq 3 ] && exit 1
exit 0
