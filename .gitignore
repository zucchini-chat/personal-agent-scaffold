.DS_Store
__pycache__/
*.pyc

# agent scratch
tmp/

# the shared browser's output (snapshots, console logs)
.playwright-mcp/

# secrets and local settings (.claude itself is tracked: it holds the hooks)
credentials.txt
!.claude
.claude/settings.local.json

# the data guard's list of private values and any renamed or backup copy of it; its markers sit in tmp/
tools/data-guard/*private-data*

# the mail guard's verdicts: they hold mail summaries (outside tmp/: a cleaned tmp/ would leave the hook inert)
tools/mail-guard/verdicts.jsonl

# the mail desk's chat id, written by guard.py watch, read by the hook
tools/mail-guard/desk-chat-id

# the mail tool's cursor, whose age is the mail desk's heartbeat (outside tmp/: a cleaned tmp/ would lose the cursor)
tools/mail-watch-cursor
